---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "Sobre Mi";

const identity = {
  firstName: "Sarah",
  country: "Canada",
  occupation: "Redactora Tecnica",
  hobbies: ["fotografia", "observacion de aves", "beisbol"],
};

const skills = ["HTML", "CSS", "JavaScript", "React", "Astro", "Escribir Documentacion"];

const happy = true;
const finished = true;
const goal = 3;

const skillColor = "crimson";
const fontWeight = "bold";
const textCase = "uppercase";
---
<BaseLayout pageTitle={pageTitle}>
  <h2>... y mi nuevo sitio de Astro!</h2>

  <p>Estoy trabajando con el tutorial introductorio de Astro. Esta es la segunda pagina de mi sitio web, y es la primera que construi yo mismo!</p>

  <p>Este sitio se va a actualizar mientras completo mas partes del tutorial, asi que sigue revisandolo y mira como va mi camino!</p>

  <p>Pues que les cuento? Soy bien genial y me gusta el Denis, jiji aun que nadie este de acuerdo pero x es mi vida bro</p>
  <p>Creo que le tengo que poner varias cositas</p>
  <p>Voy a poner cosas de mi, me gusta la Rose, me gusta el anime, el denis, mi gato es el mejor, es un gato negro porque es de la noche</p>
  <h3>Se llama MOCORITO</h3>
  <p>xd somos chavos</p>

  <p>Aqui van algunos datos sobre mi:</p>
  <ul>
    <li>Mi nombre es {identity.firstName}.</li>
    <li>Vivo en {identity.country} y trabajo como {identity.occupation}.</li>
    {identity.hobbies.length >= 2 &&
      <li>Dos de mis pasatiempos son: {identity.hobbies[0]} y {identity.hobbies[1]}</li>
    }
  </ul>
  <p>Mis habilidades son:</p>
  <ul>
    {skills.map((skill) => <li class="skill">{skill}</li>)}
  </ul>

  {happy && <p>Estoy feliz de estar aprendiendo Astro!</p>}

  {finished && <p>Termine este tutorial!</p>}

  {goal === 3 ? <p>Mi meta es terminarlo en 3 dias.</p> : <p>Mi meta no son 3 dias.</p>}

  <style is:global define:vars={{skillColor, fontWeight, textCase}}>
    h1 {
      color: purple;
      font-size: 4rem;
    }
    .skill {
      color: var(--skillColor);
      font-weight: var(--fontWeight);
      text-transform: var(--textCase);
    }
  </style>
</BaseLayout>
